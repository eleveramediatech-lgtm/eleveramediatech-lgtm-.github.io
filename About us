    <script>
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Dynamic Year
        document.getElementById('current-year').textContent = new Date().getFullYear();

        // 1. Lenis Smooth Scroll
        let lenis;
        if (!prefersReducedMotion) {
            lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true
            });

            function raf(time) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
        }

        window.addEventListener('load', () => {
            let count = 0;
            const counterEl = document.getElementById('loader-counter');
            const barEl = document.getElementById('loader-bar');
            
            const interval = setInterval(() => {
                count += Math.floor(Math.random() * 15) + 6;
                if (count >= 100) {
                    count = 100;
                    clearInterval(interval);
                    
                    setTimeout(() => {
                        gsap.to('#page-loader', {
                            yPercent: -100,
                            duration: 0.9,
                            ease: 'power4.inOut',
                            onComplete: () => {
                                document.getElementById('page-loader').style.display = 'none';
                                initHeroAnimations();
                            }
                        });
                    }, 200);
                }
                counterEl.textContent = String(count).padStart(2, '0') + '%';
                barEl.style.width = count + '%';
            }, 50);
        });

        function initHeroAnimations() {
            if (prefersReducedMotion) return;

            gsap.from('.hero-anim', {
                y: 50,
                opacity: 0,
                duration: 1,
                stagger: 0.15,
                ease: 'power3.out'
            });
        }

        const cursorGlow = document.getElementById('cursor-glow');
        window.addEventListener('mousemove', (e) => {
            if (cursorGlow) {
                cursorGlow.style.left = e.clientX + 'px';
                cursorGlow.style.top = e.clientY + 'px';
            }
        });

        gsap.registerPlugin(ScrollTrigger);

        // Header Blur on Scroll
        ScrollTrigger.create({
            start: 'top -50',
            onUpdate: (self) => {
                const nav = document.getElementById('main-nav');
                if (self.scroll() > 50) {
                    nav.classList.add('glass-nav', 'py-4');
                    nav.classList.remove('py-6');
                } else {
                    nav.classList.remove('glass-nav', 'py-4');
                    nav.classList.add('py-6');
                }
            }
        });

        // Interactive Statement Word Reveal
        const statementWords = document.querySelectorAll('#statement-text .word-reveal');
        gsap.to(statementWords, {
            scrollTrigger: {
                trigger: '#interactive-statement',
                start: 'top 75%',
                end: 'bottom 40%',
                scrub: 1
            },
            opacity: 1,
            stagger: 0.2,
            color: '#ffffff',
            ease: 'none'
        });

        // Why Elevera Vertical Highlight Updates
        const whyItems = document.querySelectorAll('.why-item');
        const activeTitle = document.getElementById('active-pillar-title');
        const activeDesc = document.getElementById('active-pillar-desc');
        const progressBar = document.getElementById('pillar-progress-bar');

        whyItems.forEach((item, idx) => {
            ScrollTrigger.create({
                trigger: item,
                start: 'top 60%',
                end: 'bottom 40%',
                onEnter: () => updateWhyPillar(item, idx),
                onEnterBack: () => updateWhyPillar(item, idx)
            });
        });

        function updateWhyPillar(item, idx) {
            whyItems.forEach(i => i.classList.add('opacity-50'));
            item.classList.remove('opacity-50');
            
            if (activeTitle && activeDesc && progressBar) {
                activeTitle.textContent = item.dataset.title;
                activeDesc.textContent = item.dataset.desc;
                progressBar.style.width = ((idx + 1) * 25) + '%';
            }
        }

        const approachSteps = [
            {
                num: "01",
                title: "DISCOVER",
                body: "Understand the business, target audience personas, competitive positioning, and baseline digital presence to uncover untapped conversion levers."
            },
            {
                num: "02",
                title: "STRATEGIZE",
                body: "Identify key digital opportunities and formulate a focused growth blueprint tailored around brand reach parameters and channels."
            },
            {
                num: "03",
                title: "EXECUTE",
                body: "Turn strategy into high-impact action through direct outreach, search optimization, synchronized local listings, and strategic content SMM."
            },
            {
                num: "04",
                title: "OPTIMIZE",
                body: "Continuously refine performance, visibility, and engagement using real-time insights to ensure maximum efficiency."
            },
            {
                num: "05",
                title: "GROW",
                body: "Build a stronger, more resilient digital foundation for long-term brand authority, continuous audience expansion, and revenue scaling."
            }
        ];

        let currentApproachIndex = 0;

        function updateApproachUI(index) {
            currentApproachIndex = index;
            const data = approachSteps[index];

            const titleEl = document.getElementById('approach-title');
            const numEl = document.getElementById('approach-number');
            const bodyEl = document.getElementById('approach-body');
            const indicatorEl = document.getElementById('approach-count-indicator');

            gsap.to('#approach-content-box', {
                opacity: 0,
                y: -10,
                duration: 0.2,
                onComplete: () => {
                    titleEl.textContent = data.title;
                    numEl.textContent = data.num;
                    bodyEl.textContent = data.body;
                    indicatorEl.textContent = `PHASE ${index + 1} OF 5`;

                    gsap.to('#approach-content-box', {
                        opacity: 1,
                        y: 0,
                        duration: 0.3
                    });
                }
            });

            document.querySelectorAll('.approach-tab').forEach((tab, i) => {
                if (i === index) {
                    tab.classList.add('border-brand-accent');
                    tab.classList.remove('border-white/10', 'opacity-60');
                } else {
                    tab.classList.remove('border-brand-accent');
                    tab.classList.add('border-white/10', 'opacity-60');
                }
            });
        }

        function setApproachStep(stepNum) {
            updateApproachUI(stepNum - 1);
        }

        function nextApproachStep() {
            const nextIdx = (currentApproachIndex + 1) % approachSteps.length;
            updateApproachUI(nextIdx);
        }

        function prevApproachStep() {
            const prevIdx = (currentApproachIndex - 1 + approachSteps.length) % approachSteps.length;
            updateApproachUI(prevIdx);
        }

        function openContactModal() {
            const modal = document.getElementById('contact-modal');
            const box = document.getElementById('contact-modal-box');
            modal.classList.remove('pointer-events-none', 'opacity-0');
            modal.classList.add('opacity-100');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
        }

        function closeContactModal() {
            const modal = document.getElementById('contact-modal');
            const box = document.getElementById('contact-modal-box');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
            box.classList.add('scale-95');
            box.classList.remove('scale-100');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            document.getElementById('agency-contact-form').classList.add('hidden');
            document.getElementById('form-success-msg').classList.remove('hidden');
        }

        // Mobile Nav Drawer
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const closeMobileNavBtn = document.getElementById('close-mobile-nav');
        const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

        function openMobileMenu() {
            mobileNavOverlay.classList.remove('translate-x-full');
        }

        function closeMobileMenu() {
            mobileNavOverlay.classList.add('translate-x-full');
        }

        if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openMobileMenu);
        if (closeMobileNavBtn) closeMobileNavBtn.addEventListener('click', closeMobileMenu);
        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });

        function initThreeJS() {
            if (prefersReducedMotion) return;

            // Hero Canvas Particles
            const heroCanvas = document.getElementById('hero-canvas');
            if (heroCanvas) {
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
                const renderer = new THREE.WebGLRenderer({ canvas: heroCanvas, alpha: true, antialias: true });
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

                const count = 750;
                const geometry = new THREE.BufferGeometry();
                const positions = new Float32Array(count * 3);
                
                for (let i = 0; i < count * 3; i += 3) {
                    positions[i] = (Math.random() - 0.5) * 15;
                    positions[i + 1] = (Math.random() - 0.5) * 15;
                    positions[i + 2] = (Math.random() - 0.5) * 15;
                }

                geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

                const material = new THREE.PointsMaterial({
                    color: 0x6366f1,
                    size: 0.035,
                    transparent: true,
                    opacity: 0.6
                });

                const particles = new THREE.Points(geometry, material);
                scene.add(particles);

                camera.position.z = 5;

                function animateHeroCanvas() {
                    requestAnimationFrame(animateHeroCanvas);
                    particles.rotation.y += 0.0008;
                    particles.rotation.x += 0.0004;
                    renderer.render(scene, camera);
                }
                animateHeroCanvas();

                window.addEventListener('resize', () => {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                });
            }

            // Cinematic Wireframe Orb
            const orbCanvas = document.getElementById('orb-canvas');
            if (orbCanvas) {
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(75, orbCanvas.clientWidth / orbCanvas.clientHeight, 0.1, 1000);
                const renderer = new THREE.WebGLRenderer({ canvas: orbCanvas, alpha: true, antialias: true });
                renderer.setSize(orbCanvas.clientWidth, orbCanvas.clientHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

                const geometry = new THREE.IcosahedronGeometry(2, 25);
                const material = new THREE.MeshBasicMaterial({
                    color: 0x22d3ee,
                    wireframe: true,
                    transparent: true,
                    opacity: 0.25
                });

                const sphere = new THREE.Mesh(geometry, material);
                scene.add(sphere);

                camera.position.z = 4.5;

                function animateOrb() {
                    requestAnimationFrame(animateOrb);
                    sphere.rotation.x += 0.003;
                    sphere.rotation.y += 0.005;
                    renderer.render(scene, camera);
                }
                animateOrb();
            }
        }

        window.onload = function() {
            initThreeJS();
        };
    </script>
