    });
    document.getElementById('btn-scores-back').addEventListener('click', () => switchScreen('screen-home'));
    document.getElementById('btn-settings-back').addEventListener('click', () => switchScreen('screen-home'));

    document.getElementById('btn-restart').addEventListener('click', () => {
      resetGame();
      gameState = 'PLAYING';
      switchScreen(null);
      document.getElementById('hud').style.display = 'flex';
      document.getElementById('touch-controls').style.display = 'flex';
    });

    document.getElementById('btn-gameover-home').addEventListener('click', () => {
      updateHomeScreenData();
      switchScreen('screen-home');
    });

    // Discount Code Verification System
    document.getElementById('btn-verify-code').addEventListener('click', () => {
      const input = document.getElementById('claim-code-input').value.trim().toUpperCase();
      const resultMsg = document.getElementById('claim-result-msg');
      const data = getStoredData();

      if (!input) {
        resultMsg.className = 'text-red';
        resultMsg.innerText = '⚠️ Please enter a code';
        return;
      }

      if (data.coupons && data.coupons[input]) {
        const coupon = data.coupons[input];
        if (coupon.claimed) {
          resultMsg.className = 'text-gold';
          resultMsg.innerText = 'ℹ️ Code already redeemed!';
        } else {
          coupon.claimed = true;
          saveStoredData(data);
          sound.playMilestone();
          resultMsg.className = 'text-cyan';
          resultMsg.innerText = `🎉 DISCOUNT VERIFIED! ${coupon.discount}% OFF UNLOCKED`;
        }
      } else {
        resultMsg.className = 'text-red';
        resultMsg.innerText = '⚠️ Invalid or expired coupon code';
      }
    });

    // Sound Setting Toggle Listener
    document.getElementById('setting-sound').addEventListener('change', (e) => {
      sound.enabled = e.target.checked;
    });
  </script>
</body>
</html>
