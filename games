<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>DROP & CATCH - Reward Edition</title>
  <!-- Google Fonts for Arcade & Modern Aesthetic -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <!-- Canvas Confetti Library for Celebrations -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --bg-dark: #090a0f;
      --card-bg: rgba(18, 22, 36, 0.75);
      --card-border: rgba(255, 255, 255, 0.12);
      --primary-cyan: #00f0ff;
      --primary-gold: #ffd700;
      --neon-red: #ff2a6d;
      --neon-blue: #05d9e8;
      --neon-green: #00ff66;
      --text-main: #f0f4f8;
      --text-muted: #8a99ad;
      --font-arcade: 'Orbitron', sans-serif;
      --font-ui: 'Rajdhani', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-ui);
      overflow: hidden;
      height: 100vh;
      width: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Container Box */
    #app-container {
      position: relative;
      width: 100%;
      max-width: 500px;
      height: 100vh;
      max-height: 900px;
      background: radial-gradient(circle at center, #141824 0%, #08090d 100%);
      box-shadow: 0 0 50px rgba(0, 240, 255, 0.15);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 520px) {
      #app-container {
        height: 92vh;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
    }

    /* Game Canvas */
    canvas#gameCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Common Overlay Screen Style */
    .screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 30px 24px;
      background: rgba(9, 10, 15, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: opacity 0.3s ease, transform 0.3s ease;
      opacity: 0;
      pointer-events: none;
      transform: scale(0.96);
    }

    .screen.active {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1);
    }

    /* Typography & Headers */
    .brand-title {
      font-family: var(--font-arcade);
      font-size: 2.2rem;
      font-weight: 900;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 2px;
      background: linear-gradient(135deg, #ffffff 0%, var(--primary-cyan) 60%, #0072ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
      margin-bottom: 4px;
    }

    .brand-subtitle {
      font-size: 0.95rem;
      letter-spacing: 3px;
      color: var(--text-muted);
      text-align: center;
      font-weight: 600;
      text-transform: uppercase;
    }

    /* UI Cards & Glassmorphism */
    .glass-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 20px;
      width: 100%;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    /* Button Styles */
    .btn {
      font-family: var(--font-arcade);
      width: 100%;
      padding: 16px;
      margin: 8px 0;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      color: #fff;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .btn-primary {
      background: linear-gradient(135deg, #00f0ff 0%, #0051ff 100%);
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.2);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--text-main);
    }

    .btn-gold {
      background: linear-gradient(135deg, #ffd700 0%, #ff8800 100%);
      color: #000;
      font-weight: 900;
    }

    .btn:hover, .btn:active {
      transform: translateY(-2px) scale(1.02);
      filter: brightness(1.15);
    }

    .btn:active {
      transform: translateY(1px) scale(0.98);
    }

    /* HUD Header */
    #hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 16px 20px;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      background: linear-gradient(to bottom, rgba(9,10,15,0.9) 0%, rgba(9,10,15,0) 100%);
    }

    .hud-box {
      display: flex;
      flex-direction: column;
    }

    .hud-label {
      font-size: 0.7rem;
      font-family: var(--font-arcade);
      color: var(--text-muted);
      letter-spacing: 1px;
    }

    .hud-value {
      font-family: var(--font-arcade);
      font-size: 1.4rem;
      font-weight: 800;
      color: #fff;
      text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }

    /* Mobile Controls Overlay */
    #touch-controls {
      position: absolute;
      bottom: 20px;
      left: 0;
      width: 100%;
      padding: 0 20px;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      pointer-events: none;
    }

    .touch-btn {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 2px solid rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(8px);
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 1.8rem;
      pointer-events: auto;
      user-select: none;
      transition: background 0.1s, transform 0.1s;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    .touch-btn:active {
      background: rgba(0, 240, 255, 0.3);
      border-color: var(--primary-cyan);
      transform: scale(0.92);
    }

    /* Coupon Reward Card Design */
    .coupon-card {
      background: linear-gradient(135deg, rgba(20,25,40,0.95) 0%, rgba(10,12,20,0.95) 100%);
      border: 2px dashed var(--primary-gold);
      border-radius: 16px;
      padding: 20px;
      text-align: center;
      position: relative;
      margin: 15px 0;
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.2);
    }

    .coupon-card::before, .coupon-card::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 20px;
      height: 20px;
      background: var(--bg-dark);
      border-radius: 50%;
      transform: translateY(-50%);
    }

    .coupon-card::before { left: -11px; }
    .coupon-card::after { right: -11px; }

    .coupon-value {
      font-family: var(--font-arcade);
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--primary-gold);
      text-shadow: 0 0 15px rgba(255, 215, 0, 0.6);
      margin: 5px 0;
    }

    .coupon-code-box {
      background: rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 10px;
      font-family: var(--font-arcade);
      font-size: 1.3rem;
      letter-spacing: 3px;
      color: var(--primary-cyan);
      margin: 10px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .copy-btn {
      background: var(--primary-cyan);
      color: #000;
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-family: var(--font-ui);
      font-weight: 700;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .copy-btn.copied {
      background: var(--neon-green);
      color: #000;
    }

    /* Milestone Popups */
    #milestone-popup {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.7);
      background: rgba(10, 14, 26, 0.95);
      border: 2px solid var(--primary-gold);
      box-shadow: 0 0 40px rgba(255, 215, 0, 0.5);
      border-radius: 20px;
      padding: 25px;
      text-align: center;
      z-index: 20;
      width: 85%;
      max-width: 360px;
      opacity: 0;
      pointer-events: none;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    #milestone-popup.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .milestone-badge {
      font-size: 3.5rem;
      margin-bottom: 5px;
      animation: bounce 0.6s ease infinite alternate;
    }

    @keyframes bounce {
      from { transform: translateY(0); }
      to { transform: translateY(-10px); }
    }

    /* Input Fields */
    .input-field {
      width: 100%;
      padding: 14px;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      color: #fff;
      font-family: var(--font-arcade);
      font-size: 1.1rem;
      text-align: center;
      margin: 12px 0;
      outline: none;
      transition: border-color 0.2s;
    }

    .input-field:focus {
      border-color: var(--primary-cyan);
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
    }

    /* Instructions Modal styling */
    .ball-info-row {
      display: flex;
      align-items: center;
      margin: 8px 0;
      gap: 12px;
      font-size: 1rem;
    }

    .ball-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 10px currentColor;
    }

    /* Toggle Switch */
    .setting-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .switch {
      position: relative;
      display: inline-block;
      width: 50px;
      height: 26px;
    }

    .switch input { opacity: 0; width: 0; height: 0; }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: rgba(255,255,255,0.2);
      transition: .3s;
      border-radius: 34px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px; width: 18px;
      left: 4px; bottom: 4px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }

    input:checked + .slider { background-color: var(--primary-cyan); }
    input:checked + .slider:before { transform: translateX(24px); }

    /* Utility */
    .text-gold { color: var(--primary-gold); }
    .text-cyan { color: var(--primary-cyan); }
    .text-red { color: var(--neon-red); }
    .center-content { text-align: center; }
  </style>
</head>
<body>

  <div id="app-container">
    <!-- Game Canvas -->
    <canvas id="gameCanvas"></canvas>

    <!-- HUD Header -->
    <div id="hud" style="display: none;">
      <div class="hud-box">
        <span class="hud-label">SCORE</span>
        <span class="hud-value" id="hud-score">0</span>
      </div>
      <div class="hud-box" style="text-align: center;">
        <span class="hud-label">LEVEL</span>
        <span class="hud-value" id="hud-level" style="color: var(--primary-cyan);">1</span>
      </div>
      <div class="hud-box" style="text-align: right;">
        <span class="hud-label">TIME</span>
        <span class="hud-value" id="hud-time">00:00</span>
      </div>
    </div>

    <!-- On-screen Left/Right Controls -->
    <div id="touch-controls" style="display: none;">
      <div class="touch-btn" id="btn-left">◀</div>
      <div class="touch-btn" id="btn-right">▶</div>
    </div>

    <!-- Milestone Reward Celebration Popup -->
    <div id="milestone-popup">
      <div class="milestone-badge" id="popup-badge">🎟️</div>
      <h2 class="brand-title" style="font-size: 1.5rem;" id="popup-title">REWARD UNLOCKED!</h2>
      <div class="coupon-value" id="popup-discount">10% OFF</div>
      <p style="color: var(--text-muted); font-size: 0.95rem;" id="popup-msg">You reached 1,000 points!</p>
    </div>

    <!-- HOME SCREEN -->
    <div class="screen active" id="screen-home">
      <div>
        <div class="brand-title">DROP & CATCH</div>
        <div class="brand-subtitle">CATCH. SCORE. UNLOCK.</div>
      </div>

      <div class="glass-card center-content" style="max-width: 360px;">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-family: var(--font-arcade);">CURRENT BEST</div>
        <div id="home-best-score" style="font-size: 2rem; font-family: var(--font-arcade); font-weight: 800; color: var(--primary-gold);">0</div>
        <div style="font-size: 0.8rem; color: var(--primary-cyan); margin-top: 4px;" id="home-highest-reward">Highest Reward: None</div>
      </div>

      <div style="width: 100%; max-width: 360px;">
        <button class="btn btn-primary" id="btn-play">▶ PLAY NOW</button>
        <button class="btn btn-gold" id="btn-home-claim">🎟️ CLAIM DISCOUNT</button>
        <button class="btn btn-secondary" id="btn-home-scores">🏆 HIGH SCORES</button>
        <button class="btn btn-secondary" id="btn-home-howto">❓ HOW TO PLAY</button>
        <button class="btn btn-secondary" id="btn-home-settings">⚙️ SETTINGS</button>
      </div>

      <div style="font-size: 0.75rem; color: var(--text-muted); text-align: center;">
        Use ← → keys or touch controls to play
      </div>
    </div>

    <!-- HOW TO PLAY SCREEN -->
    <div class="screen" id="screen-howto">
      <div>
        <div class="brand-title" style="font-size: 1.8rem;">HOW TO PLAY</div>
        <div class="brand-subtitle">MASTER THE CATCH</div>
      </div>

      <div class="glass-card" style="font-size: 0.95rem; line-height: 1.5;">
        <p style="margin-bottom: 12px;">Move your bucket left and right to catch falling score balls and unlock reward discounts!</p>

        <div class="ball-info-row">
          <span class="ball-dot" style="background: #ffffff; color: #fff;"></span>
          <span><b>White Ball:</b> +10 Points</span>
        </div>
        <div class="ball-info-row">
          <span class="ball-dot" style="background: #05d9e8; color: #05d9e8;"></span>
          <span><b>Blue Ball:</b> +30 Points</span>
        </div>
        <div class="ball-info-row">
          <span class="ball-dot" style="background: #ff2a6d; color: #ff2a6d;"></span>
          <span><b>Red Ball:</b> +50 Points</span>
        </div>
        <div class="ball-info-row" style="margin-top: 10px;">
          <span style="font-size: 1.4rem; line-height: 1;">💣</span>
          <span class="text-red"><b>BOMB:</b> Immediately resets score to 0 & ends game!</span>
        </div>

        <div style="margin-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); pt: 10px;">
          <b class="text-gold">DISCOUNT MILESTONES:</b>
          <div style="display: flex; justify-content: space-between; font-family: var(--font-arcade); font-size: 0.8rem; margin-top: 6px;">
            <span>1K pts = 10%</span>
            <span>2.5K = 25%</span>
            <span>5K = 50%</span>
            <span>10K = 100%</span>
          </div>
        </div>
      </div>

      <button class="btn btn-primary" id="btn-howto-back">GOT IT!</button>
    </div>

    <!-- CLAIM DISCOUNT SCREEN -->
    <div class="screen" id="screen-claim">
      <div>
        <div class="brand-title" style="font-size: 1.8rem;">CLAIM DISCOUNT</div>
        <div class="brand-subtitle">VERIFY YOUR REWARD CODE</div>
      </div>

      <div class="glass-card">
        <p style="text-align: center; color: var(--text-muted); font-size: 0.9rem;">
          Enter your unique coupon code generated from your gameplay high scores to verify your discount.
        </p>
        <input type="text" class="input-field" id="claim-code-input" placeholder="e.g. GAME25-X7K9P2" maxlength="15" autocomplete="off" />
        <button class="btn btn-gold" id="btn-verify-code">CLAIM DISCOUNT</button>
        <div id="claim-result-msg" style="text-align: center; margin-top: 10px; font-weight: 700; min-height: 24px;"></div>
      </div>

      <button class="btn btn-secondary" id="btn-claim-back">BACK TO HOME</button>
    </div>

    <!-- HIGH SCORES SCREEN -->
    <div class="screen" id="screen-scores">
      <div>
        <div class="brand-title" style="font-size: 1.8rem;">HIGH SCORES</div>
        <div class="brand-subtitle">YOUR HALL OF FAME</div>
      </div>

      <div class="glass-card center-content">
        <div style="font-size: 0.9rem; color: var(--text-muted);">ALL-TIME HIGHEST SCORE</div>
        <div id="scores-best-val" style="font-size: 3rem; font-family: var(--font-arcade); font-weight: 900; color: var(--primary-cyan); margin: 10px 0;">0</div>

        <div style="font-size: 0.9rem; color: var(--text-muted); margin-top: 15px;">MAX REWARD UNLOCKED</div>
        <div id="scores-reward-val" class="coupon-value" style="font-size: 2rem;">0% OFF</div>
      </div>

      <button class="btn btn-secondary" id="btn-scores-back">BACK TO HOME</button>
    </div>

    <!-- SETTINGS SCREEN -->
    <div class="screen" id="screen-settings">
      <div>
        <div class="brand-title" style="font-size: 1.8rem;">SETTINGS</div>
        <div class="brand-subtitle">PREFERENCES</div>
      </div>

      <div class="glass-card">
        <div class="setting-row">
          <span>Sound Effects (SFX)</span>
          <label class="switch">
            <input type="checkbox" id="setting-sound" checked />
            <span class="slider"></span>
          </label>
        </div>
      </div>

      <button class="btn btn-secondary" id="btn-settings-back">BACK TO HOME</button>
    </div>

    <!-- GAME OVER / RESULTS SCREEN -->
    <div class="screen" id="screen-gameover">
      <div>
        <div class="brand-title text-red" id="gameover-header" style="font-size: 2.2rem;">BOOM!</div>
        <div class="brand-subtitle" id="gameover-sub">SCORE LOST - BOMB CAUGHT</div>
      </div>

      <!-- Reward Coupon Card (shown if milestone unlocked) -->
      <div id="gameover-reward-card" class="coupon-card" style="width: 100%; display: none;">
        <div style="font-family: var(--font-arcade); font-size: 0.8rem; color: var(--primary-gold);">🎉 YOU EARNED A REWARD!</div>
        <div class="coupon-value" id="gameover-discount-val">25% OFF</div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">YOUR UNIQUE DISCOUNT CODE</div>
        <div class="coupon-code-box">
          <span id="gameover-code-text">GAME25-XXXXXX</span>
          <button class="copy-btn" id="btn-copy-code">COPY</button>
        </div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-align: left; margin-top: 8px;">
          <b>HOW TO USE:</b> Copy code ➔ Go Home ➔ Click "CLAIM DISCOUNT" ➔ Enter code.
        </div>
      </div>

      <!-- Score Summary Glass Card -->
      <div class="glass-card center-content" style="padding: 15px;">
        <div style="display: flex; justify-content: space-around;">
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-arcade);">FINAL SCORE</div>
            <div id="gameover-final-score" style="font-size: 1.5rem; font-family: var(--font-arcade); font-weight: 800; color: #fff;">0</div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-arcade);">BEST SCORE</div>
            <div id="gameover-best-score" style="font-size: 1.5rem; font-family: var(--font-arcade); font-weight: 800; color: var(--primary-gold);">0</div>
          </div>
        </div>
      </div>

      <div style="width: 100%;">
        <button class="btn btn-primary" id="btn-restart">🔄 PLAY AGAIN</button>
        <button class="btn btn-secondary" id="btn-gameover-home">🏠 HOME</button>
      </div>
    </div>

  </div>

  <script>
    /* ==========================================================================
       AUDIO SYNTHESIZER (Web Audio API)
       ========================================================================== */
    class SoundController {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) this.ctx = new AudioContext();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playCatch(freq = 440) {
        if (!this.enabled || !this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.5, this.ctx.currentTime + 0.08);

          gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);

          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.08);
        } catch (e) {}
      }

      playBomb() {
        if (!this.enabled || !this.ctx) return;
        try {
          // Low frequency explosion noise sweep
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(150, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(30, this.ctx.currentTime + 0.5);

          gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.5);

          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.5);
        } catch (e) {}
      }

      playMilestone() {
        if (!this.enabled || !this.ctx) return;
        try {
          const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
          notes.forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.08);

            gain.gain.setValueAtTime(0.2, this.ctx.currentTime + idx * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + idx * 0.08 + 0.2);

            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(this.ctx.currentTime + idx * 0.08);
            osc.stop(this.ctx.currentTime + idx * 0.08 + 0.2);
          });
        } catch (e) {}
      }

      playClick() {
        if (!this.enabled || !this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(800, this.ctx.currentTime);
          gain.gain.setValueAtTime(0.05, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.03);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.03);
        } catch (e) {}
      }
    }

    const sound = new SoundController();

    /* ==========================================================================
       GAME ENGINE & ENGINE STATE
       ========================================================================== */
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // Canvas Resizing
    let width = 0;
    let height = 0;

    function resizeCanvas() {
      const container = document.getElementById('app-container');
      width = container.clientWidth;
      height = container.clientHeight;
      canvas.width = width;
      canvas.height = height;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Persistent LocalStorage Management
    const STORAGE_KEY = 'drop_catch_game_data';

    function getStoredData() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        return stored ? JSON.parse(stored) : { bestScore: 0, highestDiscount: 0, coupons: {} };
      } catch (e) {
        return { bestScore: 0, highestDiscount: 0, coupons: {} };
      }
    }

    function saveStoredData(data) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (e) {}
    }

    // Game Constants & Configuration
    const MILESTONES = [
      { score: 1000, discount: 10, label: '10% OFF', codePrefix: 'GAME10' },
      { score: 2500, discount: 25, label: '25% OFF', codePrefix: 'GAME25' },
      { score: 5000, discount: 50, label: '50% OFF', codePrefix: 'GAME50' },
      { score: 10000, discount: 100, label: '100% OFF', codePrefix: 'GAME100' }
    ];

    const BALL_TYPES = {
      WHITE: { points: 10, color: '#ffffff', glow: 'rgba(255, 255, 255, 0.8)', radius: 12, chance: 0.6 },
      BLUE:  { points: 30, color: '#05d9e8', glow: 'rgba(5, 217, 232, 0.8)', radius: 14, chance: 0.28 },
      RED:   { points: 50, color: '#ff2a6d', glow: 'rgba(255, 42, 109, 0.8)', radius: 16, chance: 0.12 }
    };

    // State Variables
    let gameState = 'HOME'; // 'HOME', 'PLAYING', 'GAMEOVER'
    let score = 0;
    let level = 1;
    let gameTime = 0; // seconds
    let lastTime = 0;
    let spawnTimer = 0;
    let levelTimer = 0;
    let activeMilestoneIndex = -1;
    let highestUnlockedDiscountInRun = 0;

    // Background Themes & Interpolation
    const BG_THEMES = [
      { score: 0,     c1: [9, 10, 15],     c2: [20, 24, 36] },      // Dark Standard
      { score: 1000,  c1: [10, 26, 20],    c2: [15, 45, 30] },      // Dark Green
      { score: 2500,  c1: [5, 35, 40],     c2: [10, 60, 65] },      // Energetic Neon Cyan
      { score: 5000,  c1: [35, 30, 10],    c2: [65, 55, 15] },      // Gold/Yellow
      { score: 10000, c1: [45, 30, 5],     c2: [90, 65, 10] }       // Legendary Bright Gold
    ];
    let currentBgColors = { c1: [9, 10, 15], c2: [20, 24, 36] };

    // Input States
    const keys = { left: false, right: false };

    // Bucket Entity (SINGLE BUCKET MANDATE)
    const bucket = {
      x: 0,
      y: 0,
      width: 90,
      height: 24,
      speed: 480, // px per sec
      vx: 0,
      bounceScale: 1.0,
      catchAnim: 0
    };

    // Lists for Entities
    let fallingObjects = [];
    let particles = [];
    let floatingTexts = [];

    /* ==========================================================================
       ENTITY HELPERS & SPAWNING
       ========================================================================== */
    function resetGame() {
      score = 0;
      level = 1;
      gameTime = 0;
      spawnTimer = 0;
      levelTimer = 0;
      activeMilestoneIndex = -1;
      highestUnlockedDiscountInRun = 0;

      fallingObjects = [];
      particles = [];
      floatingTexts = [];

      bucket.width = 90;
      bucket.x = width / 2 - bucket.width / 2;
      bucket.y = height - 90;

      updateHUD();
    }

    function spawnObject() {
      // Calculate Bomb Spawn Chance based on level
      const bombChance = Math.min(0.12 + (level - 1) * 0.03, 0.35);
      const isBomb = Math.random() < bombChance;

      const objX = Math.random() * (width - 40) + 20;

      if (isBomb) {
        fallingObjects.push({
          type: 'BOMB',
          x: objX,
          y: -20,
          radius: 16,
          speed: 180 + (level * 25) + Math.random() * 30,
          rotation: 0,
          rotSpeed: (Math.random() - 0.5) * 4
        });
      } else {
        // Pick Ball Type
        const rand = Math.random();
        let type = 'WHITE';
        if (rand > 1 - BALL_TYPES.RED.chance) {
          type = 'RED';
        } else if (rand > 1 - BALL_TYPES.RED.chance - BALL_TYPES.BLUE.chance) {
          type = 'BLUE';
        }

        const ballConfig = BALL_TYPES[type];
        fallingObjects.push({
          type: 'BALL',
          subType: type,
          x: objX,
          y: -20,
          radius: ballConfig.radius,
          points: ballConfig.points,
          color: ballConfig.color,
          glow: ballConfig.glow,
          speed: 160 + (level * 20) + Math.random() * 40,
          rotation: 0,
          rotSpeed: (Math.random() - 0.5) * 3
        });
      }
    }

    function createParticleBurst(x, y, color, count = 12) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 150 + 50;
        particles.push({
          x: x,
          y: y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          color: color,
          radius: Math.random() * 3 + 2,
          alpha: 1.0,
          life: Math.random() * 0.3 + 0.3
        });
      }
    }

    function createFloatingText(x, y, text, color) {
      floatingTexts.push({
        x: x,
        y: y,
        text: text,
        color: color,
        alpha: 1.0,
        vy: -60
      });
    }

    /* ==========================================================================
       UPDATE LOOP logic
       ========================================================================== */
    function update(dt) {
      if (gameState !== 'PLAYING') return;

      // Timers & Difficulty
      gameTime += dt;
      levelTimer += dt;
      if (levelTimer >= 30) {
        levelTimer = 0;
        level++;
        sound.playMilestone();
        createFloatingText(width / 2, height / 2 - 50, `LEVEL ${level}!`, '#00f0ff');
      }

      // Object Spawning
      const currentSpawnDelay = Math.max(0.35, 0.95 - (level * 0.06));
      spawnTimer += dt;
      if (spawnTimer >= currentSpawnDelay) {
        spawnTimer = 0;
        spawnObject();
      }

      // Manual Bucket Movement Control ONLY
      let moveDir = 0;
      if (keys.left) moveDir -= 1;
      if (keys.right) moveDir += 1;

      bucket.vx = moveDir * bucket.speed;
      bucket.x += bucket.vx * dt;

      // Strict Boundary Constraints
      if (bucket.x < 10) bucket.x = 10;
      if (bucket.x + bucket.width > width - 10) bucket.x = width - 10 - bucket.width;

      // Bucket Catch Animation recovery
      if (bucket.catchAnim > 0) {
        bucket.catchAnim -= dt * 5;
        if (bucket.catchAnim < 0) bucket.catchAnim = 0;
      }

      // Update Falling Objects
      for (let i = fallingObjects.length - 1; i >= 0; i--) {
        const obj = fallingObjects[i];
        obj.y += obj.speed * dt;
        obj.rotation += obj.rotSpeed * dt;

        // Collision Check with Bucket Top Area
        const bucketTop = bucket.y;
        const bucketBottom = bucket.y + bucket.height;
        const bucketLeft = bucket.x;
        const bucketRight = bucket.x + bucket.width;

        if (
          obj.y + obj.radius >= bucketTop &&
          obj.y - obj.radius <= bucketBottom &&
          obj.x >= bucketLeft - 5 &&
          obj.x <= bucketRight + 5
        ) {
          // Object Caught!
          if (obj.type === 'BOMB') {
            triggerBombGameOver(obj.x, obj.y);
            return;
          } else {
            // Ball Caught
            score += obj.points;
            bucket.catchAnim = 1.0;
            sound.playCatch(obj.subType === 'RED' ? 650 : obj.subType === 'BLUE' ? 520 : 440);

            createParticleBurst(obj.x, obj.y, obj.color, 14);
            createFloatingText(obj.x, obj.y - 10, `+${obj.points}`, obj.color);

            checkMilestones(score);
            fallingObjects.splice(i, 1);
            continue;
          }
        }

        // Object Missed Screen Bottom
        if (obj.y - obj.radius > height) {
          fallingObjects.splice(i, 1);
        }
      }

      // Update Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.alpha -= dt / p.life;
        if (p.alpha <= 0) {
          particles.splice(i, 1);
        }
      }

      // Update Floating Text
      for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy * dt;
        ft.alpha -= dt * 1.2;
        if (ft.alpha <= 0) {
          floatingTexts.splice(i, 1);
        }
      }

      // Dynamic Background Interpolation
      updateBackgroundColors();

      // Refresh HUD Text
      updateHUD();
    }

    function checkMilestones(currentScore) {
      for (let i = MILESTONES.length - 1; i >= 0; i--) {
        const m = MILESTONES[i];
        if (currentScore >= m.score && activeMilestoneIndex < i) {
          activeMilestoneIndex = i;
          highestUnlockedDiscountInRun = m.discount;
          triggerMilestoneCelebration(m);
          break;
        }
      }
    }

    function triggerMilestoneCelebration(milestone) {
      sound.playMilestone();

      // Trigger Confetti explosion
      if (window.confetti) {
        confetti({
          particleCount: milestone.discount === 100 ? 150 : 80,
          spread: 70,
          origin: { y: 0.6 }
        });
      }

      const popup = document.getElementById('milestone-popup');
      const badge = document.getElementById('popup-badge');
      const title = document.getElementById('popup-title');
      const discount = document.getElementById('popup-discount');
      const msg = document.getElementById('popup-msg');

      if (milestone.discount === 100) {
        badge.innerHTML = '👑';
        title.innerHTML = '100% DISCOUNT!';
        title.style.color = 'var(--primary-gold)';
        discount.innerHTML = 'LEGENDARY SCORE!';
        msg.innerHTML = `You hit ${milestone.score.toLocaleString()} points!`;
      } else {
        badge.innerHTML = '🎟️';
        title.innerHTML = 'REWARD UNLOCKED!';
        title.style.color = '#fff';
        discount.innerHTML = milestone.label;
        msg.innerHTML = `You reached ${milestone.score.toLocaleString()} points!`;
      }

      popup.classList.add('show');
      setTimeout(() => {
        popup.classList.remove('show');
      }, 2500);
    }

    function triggerBombGameOver(bombX, bombY) {
      sound.playBomb();
      gameState = 'GAMEOVER';

      // Massive explosion effects
      createParticleBurst(bombX, bombY, '#ff2a6d', 40);
      createParticleBurst(bombX, bombY, '#ffd700', 30);
      createParticleBurst(bombX, bombY, '#ffffff', 20);

      const savedData = getStoredData();

      // Check if player unlocked any discount code
      let generatedCode = null;
      let rewardLabel = null;

      if (highestUnlockedDiscountInRun > 0) {
        const m = MILESTONES.find(item => item.discount === highestUnlockedDiscountInRun);
        if (m) {
          // Generate unique code format e.g. GAME25-X7K9P2
          const randomSuffix = Math.random().toString(36).substring(2, 8).toUpperCase();
          generatedCode = `${m.codePrefix}-${randomSuffix}`;
          rewardLabel = m.label;

          // Save into local storage
          savedData.coupons[generatedCode] = {
            discount: m.discount,
            claimed: false,
            date: new Date().toLocaleDateString()
          };
        }
      }

      // Update High Scores
      if (score > savedData.bestScore) {
        savedData.bestScore = score;
      }
      if (highestUnlockedDiscountInRun > savedData.highestDiscount) {
        savedData.highestDiscount = highestUnlockedDiscountInRun;
      }
      saveStoredData(savedData);

      // Reset score to 0 on Bomb as per requirements
      const finalScore = score;
      score = 0;
      updateHUD();

      // Render Results Screen
      setTimeout(() => {
        document.getElementById('hud').style.display = 'none';
        document.getElementById('touch-controls').style.display = 'none';

        document.getElementById('gameover-final-score').innerText = finalScore.toLocaleString();
        document.getElementById('gameover-best-score').innerText = savedData.bestScore.toLocaleString();

        const card = document.getElementById('gameover-reward-card');
        if (generatedCode) {
          card.style.display = 'block';
          document.getElementById('gameover-discount-val').innerText = rewardLabel;
          document.getElementById('gameover-code-text').innerText = generatedCode;

          const copyBtn = document.getElementById('btn-copy-code');
          copyBtn.className = 'copy-btn';
          copyBtn.innerText = 'COPY';
          copyBtn.onclick = () => {
            navigator.clipboard.writeText(generatedCode);
            copyBtn.innerText = '✓ COPIED!';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.innerText = 'COPY';
              copyBtn.classList.remove('copied');
            }, 2000);
          };
        } else {
          card.style.display = 'none';
        }

        switchScreen('screen-gameover');
      }, 800);
    }

    function updateBackgroundColors() {
      // Find current theme step based on score
      let target = BG_THEMES[0];
      for (let i = BG_THEMES.length - 1; i >= 0; i--) {
        if (score >= BG_THEMES[i].score) {
          target = BG_THEMES[i];
          break;
        }
      }

      // Smooth color transitions
      for (let i = 0; i < 3; i++) {
        currentBgColors.c1[i] += (target.c1[i] - currentBgColors.c1[i]) * 0.05;
        currentBgColors.c2[i] += (target.c2[i] - currentBgColors.c2[i]) * 0.05;
      }
    }

    function updateHUD() {
      document.getElementById('hud-score').innerText = score.toLocaleString();
      document.getElementById('hud-level').innerText = level;

      const mins = Math.floor(gameTime / 60).toString().padStart(2, '0');
      const secs = Math.floor(gameTime % 60).toString().padStart(2, '0');
      document.getElementById('hud-time').innerText = `${mins}:${secs}`;
    }

    /* ==========================================================================
       CANVAS RENDERING ENGINE
       ========================================================================== */
    function render() {
      // Clear with dynamic gradient background
      const c1 = `rgb(${Math.round(currentBgColors.c1[0])}, ${Math.round(currentBgColors.c1[1])}, ${Math.round(currentBgColors.c1[2])})`;
      const c2 = `rgb(${Math.round(currentBgColors.c2[0])}, ${Math.round(currentBgColors.c2[1])}, ${Math.round(currentBgColors.c2[2])})`;

      const bgGrad = ctx.createRadialGradient(width / 2, height / 2, 50, width / 2, height / 2, width);
      bgGrad.addColorStop(0, c2);
      bgGrad.addColorStop(1, c1);
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // Render Subtle Grid Lines in Background
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
      ctx.lineWidth = 1;
      const gridSize = 40;
      for (let x = 0; x < width; x += gridSize) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
      }
      for (let y = 0; y < height; y += gridSize) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
      }

      if (gameState === 'PLAYING' || gameState === 'GAMEOVER') {
        // Draw Falling Objects
        fallingObjects.forEach(obj => {
          ctx.save();
          ctx.translate(obj.x, obj.y);
          ctx.rotate(obj.rotation);

          if (obj.type === 'BOMB') {
            // Animated Bomb with Pulse & Glow
            const pulse = Math.sin(Date.now() * 0.01) * 3;
            ctx.shadowColor = '#ff2a6d';
            ctx.shadowBlur = 15;

            // Dark Body
            ctx.fillStyle = '#1a1a24';
            ctx.beginPath();
            ctx.arc(0, 0, obj.radius + pulse * 0.3, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ff2a6d';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Fuse Spark
            ctx.fillStyle = '#ffd700';
            ctx.beginPath();
            ctx.arc(0, -obj.radius - 2, 4, 0, Math.PI * 2);
            ctx.fill();
          } else {
            // Ball with Neon Glow
            ctx.shadowColor = obj.glow;
            ctx.shadowBlur = 12;

            ctx.fillStyle = obj.color;
            ctx.beginPath();
            ctx.arc(0, 0, obj.radius, 0, Math.PI * 2);
            ctx.fill();

            // Inner Highlight
            ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
            ctx.beginPath();
            ctx.arc(-obj.radius * 0.3, -obj.radius * 0.3, obj.radius * 0.3, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        });

        // Draw SINGLE BUCKET
        ctx.save();
        const bHeight = bucket.height * (1 - bucket.catchAnim * 0.2);
        const bY = bucket.y + (bucket.height - bHeight);

        // Bucket Glow
        ctx.shadowColor = 'rgba(0, 240, 255, 0.6)';
        ctx.shadowBlur = 15;

        // Bucket Metallic/Neon Gradient
        const bucketGrad = ctx.createLinearGradient(bucket.x, bY, bucket.x, bY + bHeight);
        bucketGrad.addColorStop(0, '#00f0ff');
        bucketGrad.addColorStop(0.5, '#0072ff');
        bucketGrad.addColorStop(1, '#002699');

        ctx.fillStyle = bucketGrad;
        ctx.beginPath();
        ctx.roundRect(bucket.x, bY, bucket.width, bHeight, [0, 0, 12, 12]);
        ctx.fill();

        // Top Rim Highlight
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(bucket.x - 2, bY - 2, bucket.width + 4, 5, 3);
        ctx.fill();
        ctx.restore();

        // Draw Particles
        particles.forEach(p => {
          ctx.save();
          ctx.globalAlpha = Math.max(0, p.alpha);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        });

        // Draw Floating Texts
        floatingTexts.forEach(ft => {
          ctx.save();
          ctx.globalAlpha = Math.max(0, ft.alpha);
          ctx.font = '900 1.2rem "Orbitron", sans-serif';
          ctx.fillStyle = ft.color;
          ctx.textAlign = 'center';
          ctx.fillText(ft.text, ft.x, ft.y);
          ctx.restore();
        });
      }
    }

    /* ==========================================================================
       MAIN GAME LOOP
       ========================================================================== */
    function gameLoop(timestamp) {
      if (!lastTime) lastTime = timestamp;
      const dt = Math.min((timestamp - lastTime) / 1000, 0.1); // Clamp delta time
      lastTime = timestamp;

      update(dt);
      render();

      requestAnimationFrame(gameLoop);
    }
    requestAnimationFrame(gameLoop);

